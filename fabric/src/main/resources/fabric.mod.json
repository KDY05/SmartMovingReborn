{
  "schemaVersion": 1,
  "id": "smartmovingreborn",
  "version": "${version}",
  "name": "Smart Moving Reborn",
  "description": "A port of Divisor's Smart Moving to modern Minecraft: crawling, climbing, sliding, wall jumping, diving and more.",
  "authors": [
    "kdy05"
  ],
  "contributors": [
    "Divisor (original Smart Moving)",
    "JonnyNova (Smart Moving 1.10.2 port)"
  ],
  "contact": {
