  },
  "license": "GPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.kdy05.smartmovingreborn.fabric.SmartMovingRebornFabric"
    ],
    "client": [
      "io.github.kdy05.smartmovingreborn.fabric.SmartMovingRebornFabricClient"
    ]
  },
  "mixins": [
    "smartmovingreborn.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
